{
  // Open in GitHub Codespaces (Code → Codespaces → Create) or VS Code Dev
  // Containers for a ready-to-run environment: no local installs needed.
  "name": "CityBuilder",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "postCreateCommand": "npm ci",
  "forwardPorts": [5173],
  "portsAttributes": { "5173": { "label": "Viewer", "onAutoForward": "openPreview" } },
  "customizations": {
    "vscode": { "extensions": ["dbaeumer.vscode-eslint"] },
    "codespaces": { "openFiles": ["docs/QUICKSTART.md"] }
  },
  "hostRequirements": { "memory": "8gb" }
}
